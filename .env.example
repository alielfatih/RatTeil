# RatTeil Configuration

# Application settings
DEBUG=true
APP_NAME=RatTeil
APP_VERSION=1.0.0

# Path settings (relative to project root)
DATA_DIR=ratteil/data
AUDIO_DIR=audio
STREAM_DIR=stream
LOG_DIR=logs

# API Keys (get these from your service providers)
# RATTEIL_AC=your_access_key
# RATTEIL_SE=your_secret_key

# YouTube API (for live streaming)
# YOUTUBE_API_KEY=your_api_key
# YOUTUBE_CLIENT_SECRETS=path/to/client_secrets.json
# YOUTUBE_CREDENTIALS_FILE=path/to/credentials.json

# API endpoints
QURAN_API_BASE=https://api.quran.com/api/v4

# Stream settings
STREAM_TITLE=RatTeil Stream
STREAM_DESCRIPTION=Automated Quran recitation stream
STREAM_CATEGORY=28  # Religion category for YouTube

# Audio settings
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192k
MAX_AUDIO_LENGTH=3600  # 1 hour in seconds

# Randomization settings
MAX_RECITERS=5
MAX_SURAHS=10
