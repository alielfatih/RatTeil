# RatTeil Configuration Example
# Copy this file to .env and update with your settings

# =============================================================================
# Application Settings
# =============================================================================

# Application name (optional)
RATTEIL_APP_NAME=RatTeil

# Enable debug logging (true/false)
RATTEIL_DEBUG=False

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
RATTEIL_LOG_LEVEL=INFO

# Path to log file (optional)
# RATTEIL_LOG_FILE=/var/log/ratteil.log

# =============================================================================
# Directory Settings
# =============================================================================

# Base directory for all RatTeil data
# Default: ~/RatTeil-resources
RATTEIL_DATA_DIR=~/RatTeil-resources

# Directory for audio files
# Default: {DATA_DIR}/audios
RATTEIL_AUDIO_DIR=

# Directory for images
# Default: {DATA_DIR}/imgs
RATTEIL_IMG_DIR=

# Directory for fixer files (intro/outro)
# Default: {DATA_DIR}/fixer
RATTEIL_FIXER_DIR=

# Directory for Facebook stream files
# Default: {DATA_DIR}/fb_stream
RATTEIL_FB_STREAM_DIR=

# =============================================================================
# YouTube Authentication
# =============================================================================

# REQUIRED for YouTube streaming
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create a project, enable YouTube Data API v3, then create OAuth 2.0 credentials

RATTEIL_YOUTUBE_CLIENT_ID=your_youtube_client_id
RATTEIL_YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Optional: Pre-existing tokens (will be auto-generated if not provided)
RATTEIL_YOUTUBE_ACCESS_TOKEN=
RATTEIL_YOUTUBE_REFRESH_TOKEN=
RATTEIL_YOUTUBE_TOKEN_EXPIRY=

# =============================================================================
# Facebook Authentication
# =============================================================================

# REQUIRED for Facebook streaming
# Get these from Facebook Developer Portal: https://developers.facebook.com/

RATTEIL_FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
RATTEIL_FACEBOOK_APP_SECRET=your_facebook_app_secret
RATTEIL_FACEBOOK_PAGE_ID=your_facebook_page_id

# =============================================================================
# Streaming Configuration
# =============================================================================

# Maximum stream length in minutes (default: 75)
RATTEIL_MAX_STREAM_LENGTH=75

# Minimum stream length in minutes (default: 120)
RATTEIL_MIN_STREAM_LENGTH=120

# Maximum number of concurrent downloads (default: 5)
RATTEIL_MAX_CONCURRENT_DOWNLOADS=5

# Download timeout in seconds (default: 60)
RATTEIL_DOWNLOAD_TIMEOUT=60

# =============================================================================
# FFmpeg Configuration
# =============================================================================

# Path to ffmpeg executable (default: ffmpeg)
# Windows example: C:\\ffmpeg\\bin\\ffmpeg.exe
# Android (Termux) example: /data/data/com.termux/files/usr/bin/ffmpeg
RATTEIL_FFMPPEG_PATH=ffmpeg

# Path to ffprobe executable (default: ffprobe)
RATTEIL_FFPROBE_PATH=ffprobe

# =============================================================================
# Randomization Configuration
# =============================================================================

# Default number of reciters to select (default: 5)
RATTEIL_DEFAULT_RECITERS_COUNT=5

# Default number of surahs to select (default: 30)
RATTEIL_DEFAULT_SURAHS_COUNT=30

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for Quran API (default: https://api.quran.com)
RATTEIL_API_BASE_URL=https://api.quran.com

# =============================================================================
# Platform Override (optional)
# =============================================================================

# Override platform detection (linux, windows, darwin, android, ios)
# Useful for testing or special environments
# RATTEIL_PLATFORM=
